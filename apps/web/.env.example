# Copy to apps/web/.env.local and adjust. Never commit real env files.
# NEXT_PUBLIC_* values are inlined at BUILD time (static export), so rebuild
# after changing them.

# Base URL of the API. For a phone or emulator, use an address the device can
# reach (e.g. http://10.0.2.2:4000 for the Android emulator, or your LAN IP).
# Leave the line out to use http://localhost:4000. Set it empty to build
# without an API (the app then shows "API unreachable" and makes no request).
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL path the app is served under. Leave unset (root) for local and Capacitor
# builds; the GitHub Pages workflow sets /PadelLoyalty.
# NEXT_PUBLIC_BASE_PATH=
