# Copy to apps/api/.env and adjust. Never commit the real .env.

# PostgreSQL connection string (docker compose defaults).
DATABASE_URL=postgres://padel:padel@localhost:5432/padelloyalty

# Database used by `pnpm test` (integration tests run migrations on it).
# Required, with no fallback; must differ from DATABASE_URL. A shell value overrides this file.
TEST_DATABASE_URL=postgres://padel:padel@localhost:5432/padelloyalty_test

# Where the API listens.
HOST=0.0.0.0
PORT=4000

# Comma-separated origins allowed to call the API from a browser:
# the Next.js dev server, plus the Capacitor iOS and Android web views.
CORS_ORIGINS=http://localhost:3000,capacitor://localhost,https://localhost

# Base URL of the web app, used for links in verification and password-reset emails.
# Include the base path when the app is served under one (GitHub Pages).
APP_URL=http://localhost:3000

# true when the API runs behind a reverse proxy, so rate limits use the client's IP.
TRUST_PROXY=false

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
