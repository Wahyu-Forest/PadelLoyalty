{
  "name": "@padelloyalty/api",
  "version": "0.0.0",
  "private": true,
  "description": "PadelLoyalty API (Fastify)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@padelloyalty/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.1.1"
  }
}
