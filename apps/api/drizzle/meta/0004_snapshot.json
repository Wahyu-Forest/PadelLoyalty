          "name": "points_ledger_entries_actor",
          "value": "(\"points_ledger_entries\".\"actor_type\" = 'system') = (\"points_ledger_entries\".\"actor_user_id\" is null)"
        },
        "points_ledger_entries_text_lengths": {
