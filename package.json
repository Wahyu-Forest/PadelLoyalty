{
  "name": "padelloyalty",
  "private": true,
  "description": "Soul Padel member app and Almas loyalty programme",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint && pnpm run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "db:generate": "pnpm --filter @padelloyalty/api run db:generate",
    "db:migrate": "pnpm --filter @padelloyalty/api run db:migrate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "turbo": "^2.11.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0"
  }
}
